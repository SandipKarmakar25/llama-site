# ==========================================================================
# Copy this file to `.env` in the PROJECT ROOT (not in server/) and fill it in.
#
#   cp server/.env.example .env
#
# Never commit .env. It is already in .gitignore.
# ==========================================================================

# --- Stripe keys ----------------------------------------------------------
# From https://dashboard.stripe.com/test/apikeys
# Use sk_test_/pk_test_ until you have tested the whole flow end to end.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Webhook signing secret ----------------------------------------------
# Local development, from the Stripe CLI:
#   stripe listen --forward-to localhost:4173/api/stripe/webhook
# It prints `whsec_...` on startup - paste that here.
#
# Production: Dashboard > Developers > Webhooks > your endpoint > signing secret.
# The secret is DIFFERENT for the CLI and for each deployed endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Site --------------------------------------------------------------------
# Used to build Checkout success/cancel URLs, and to decide whether the session
# cookie gets the Secure flag (it does when this is https).
# In production set this to the PUBLIC site origin - the Vercel domain, not the
# Railway one - or customers will be redirected to the wrong host after paying.
SITE_URL=http://localhost:4173

# Railway sets PORT itself; leave this for local use only.
PORT=4173

# --- Sessions ----------------------------------------------------------------
# Signs the session cookie. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Optional locally (one is generated and cached in server/data/). REQUIRED in
# production on ephemeral storage, otherwise every deploy invents a new secret
# and signs all your customers out.
# SESSION_SECRET=

# --- Storage -----------------------------------------------------------------
# Where the local subscription projection lives. Point this at a mounted
# volume in production (e.g. /data on Railway) so it survives redeploys.
# LLAMA_DATA_DIR=/data

# --- Stripe Tax --------------------------------------------------------------
# Prices are tax-EXCLUSIVE, so this must be true in production: with it false,
# nothing is added at checkout and you collect no tax at all.
# Requires a head office address and your registrations at
# https://dashboard.stripe.com/settings/tax
# While false, the pricing page says tax is not being calculated rather than
# promising VAT that never arrives.
STRIPE_AUTOMATIC_TAX=true
